+
+-- Aplica o tipo escolhido no PhysicsEngine do Studio.
+function Connector.AplicarFisica(engine: any, tipo: string?): boolean
+	if engine == nil or typeof(tipo) ~= "string" then
+		return false
+	end
+	local ok = pcall(function()
