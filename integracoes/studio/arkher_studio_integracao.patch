+		local baixo = texto:lower()
+		local tipo = "flutuar"
+		if baixo:find("gir") or baixo:find("roda") or baixo:find("spin") then
+			tipo = "girar"
+		elseif baixo:find("puls") or baixo:find("coracao") or baixo:find("respira") then
