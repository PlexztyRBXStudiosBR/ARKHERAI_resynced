+	local function addResultado(tituloTxt: string, urlTxt: string, resumoTxt: string, licencaTxt: string)
+		local card = Instance.new("Frame")
+		card.Size = UDim2.new(1, 0, 0, 64)
+		card.AutomaticSize = Enum.AutomaticSize.Y
+		card.BackgroundColor3 = PANEL_CARD
+		card.BorderSizePixel = 0
+		corner(card, 8)
+
+		local t = rotulo(tituloTxt, 12, NEON)
+		t.Size = UDim2.new(1, -12, 0, 16)
