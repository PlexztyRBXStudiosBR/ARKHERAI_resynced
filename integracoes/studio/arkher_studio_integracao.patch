+        if (ev[1] === 'done') done = payload;
+        else if (ev[1] === 'error') erro = payload;
+        else if (ev[1] === 'token') tokens += 1;
+      } catch { /* dado parcial — ignora */ }
+    }
+    return { done, erro, tokens };
+  }
