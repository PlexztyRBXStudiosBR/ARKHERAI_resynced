+--!strict
+-- Arkher Studio - AgentPanel - ARKHER AGENT AI
+-- Painel REAL da ARKHER AI dentro do Studio: chat, geração 3D materializada,
+-- animações aplicadas de verdade, jogo completo peça a peça e pesquisa na web
+-- em fontes abertas (Wikipedia, Internet Archive, docs oficiais do Roblox).
+-- Nada de mock: se o backend ARKHER está fora, o painel avisa com honestidade.
+
+local HttpService = game:GetService("HttpService")
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+
+local AgentPanel = {}
+AgentPanel.__index = AgentPanel
+
+-- Backend do proprio Arkher Studio faz proxy para o backend ARKHER AI.
+local API_BASE = "http://localhost:3000/api/arkherai"
+local AGENT_ROOT = "ArkherAgent"
+local NEON = Color3.fromRGB(0, 212, 122)
+local NEON_DARK = Color3.fromRGB(0, 120, 70)
+local PANEL_BG = Color3.fromRGB(16, 20, 18)
+local PANEL_CARD = Color3.fromRGB(26, 32, 29)
