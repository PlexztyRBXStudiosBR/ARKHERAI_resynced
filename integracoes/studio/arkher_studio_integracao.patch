+function AgentPanel:_addBolha(texto: string, ehUsuario: boolean)
+	local pagina = self.pages.chat
+	if not pagina then return end
+	local historico = pagina:FindFirstChild("Historico") :: ScrollingFrame
+	local layout = historico and historico:FindFirstChildOfClass("UIListLayout")
+	local bolha = Instance.new("Frame")
+	bolha.Size = UDim2.new(0.92, 0, 0, 20)
+	bolha.AutomaticSize = Enum.AutomaticSize.Y
+	bolha.BackgroundColor3 = if ehUsuario then NEON_DARK else PANEL_CARD
+	bolha.BorderSizePixel = 0
+	corner(bolha, 8)
+	local txt = rotulo(texto, 12, TEXT_MAIN)
+	txt.Size = UDim2.new(1, -16, 0, 0)
+	txt.Position = UDim2.new(0, 8, 0, 6)
+	txt.AutomaticSize = Enum.AutomaticSize.Y
+	local pad = Instance.new("UIPadding")
+	pad.PaddingBottom = UDim.new(0, 6)
+	pad.Parent = txt
+	txt.Parent = bolha
+	bolha.Parent = historico
+	if layout and historico then
+		task.wait()
+		historico.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
+		historico.CanvasPosition = Vector2.new(0, historico.CanvasSize.Y.Offset)
+	end
+end
