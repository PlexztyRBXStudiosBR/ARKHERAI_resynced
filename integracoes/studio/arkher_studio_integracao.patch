+-- -------------------------------------------------------------- status real
+function AgentPanel:_checarStatus()
+	task.spawn(function()
+		local ok, dados = self:_request("GET", "/real/model/status")
+		if ok and dados.ok ~= false and dados.state then
+			self.modelStatus = dados.state
+			if self.statusDot then
+				self.statusDot.BackgroundColor3 = if dados.state == "ready" then NEON else Color3.fromRGB(220, 160, 40)
+			end
+			if self.statusLabel then
+				local nome = dados.name or "ARKHER-1"
+				self.statusLabel.Text = if dados.state == "ready"
+					then (nome .. " - pronto (IA propria, sem provedor externo)")
+					else (nome .. " - " .. tostring(dados.state))
+			end
+		else
+			self.modelStatus = "offline"
+			if self.statusDot then
+				self.statusDot.BackgroundColor3 = Color3.fromRGB(220, 70, 60)
+			end
+			if self.statusLabel then
+				self.statusLabel.Text = "Backend ARKHER offline - suba o backend e tente de novo"
+			end
+		end
+	end)
+end
