+function AgentPanel:_enviarChat(mensagem: string, input: TextBox?)
+	if mensagem == "" then return end
+	self:_addBolha("Voce: " .. mensagem, true)
+	if input then input.Text = "" end
+	self:_addBolha("ARKHER pensando...", false)
+	task.spawn(function()
+		local ok, dados = self:_post("/real/chat", { message = mensagem, memory_enabled = true })
+		local historico = self.pages.chat and self.pages.chat:FindFirstChild("Historico")
+		if historico then
+			local filhos = historico:GetChildren()
+			local ultima = filhos[#filhos]
+			if ultima and ultima ~= historico:FindFirstChildOfClass("UIListLayout") then
+				ultima:Destroy() -- remove o "pensando..."
+			end
+		end
+		if not ok then
+			self:_addBolha("[ARKHER] " .. tostring((dados or {}).erro), false)
+			return
+		end
+		if dados.ok == false then
+			self:_addBolha("[ARKHER] " .. tostring(dados.error or dados.message or "nao consegui responder."), false)
+			return
+		end
+		local ms = dados.metrics and dados.metrics.ms
+		local extra = if ms then string.format("  (%d ms)", ms) else ""
+		self:_addBolha("[ARKHER] " .. tostring(dados.content or "") .. extra, false)
+	end)
+end
