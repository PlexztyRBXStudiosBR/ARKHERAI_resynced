+-- ------------------------------------------------------------- materializar
+function AgentPanel:_materializarOps(ops: { any }, nomeModelo: string): number
+	local pasta = self:_pastaAgente()
+	local modelo = Instance.new("Model")
+	modelo.Name = nomeModelo
+	local criadas = 0
+	for _, op in ops do
+		if op.op == "part" and typeof(op.pos) == "table" and typeof(op.size) == "table" then
+			local part = Instance.new("Part")
+			part.Name = tostring(op.nome or "Peca")
+			part.Size = Vector3.new(op.size[1] or 4, op.size[2] or 4, op.size[3] or 4)
+			part.Position = Vector3.new(op.pos[1] or 0, op.pos[2] or 0, op.pos[3] or 0)
+			local cor = op.cor
+			if typeof(cor) == "table" then
+				part.Color = Color3.fromRGB(cor[1] or 160, cor[2] or 160, cor[3] or 160)
+			end
+			part.Anchored = op.ancorado ~= false
+			part.Material = Enum.Material.SmoothPlastic
+			part.TopSurface = Enum.SurfaceType.Smooth
+			part.BottomSurface = Enum.SurfaceType.Smooth
+			part.Parent = modelo
+			criadas += 1
+		end
+	end
+	modelo.Parent = pasta
+	if modelo.PrimaryPart == nil and modelo:FindFirstChildWhichIsA("BasePart") then
+		modelo.PrimaryPart = modelo:FindFirstChildWhichIsA("BasePart")
+	end
+	return criadas
+end
+
+-- ----------------------------------------------------------------- animação
+local function interpolar(trilha: any, t: number): any
+	local kfs = trilha.keyframes
+	if not kfs or #kfs == 0 then
+		return nil
+	end
+	if t <= kfs[1].t then
+		return kfs[1].valor
+	end
+	for i = 1, #kfs - 1 do
+		local a, b = kfs[i], kfs[i + 1]
+		if t >= a.t and t <= b.t then
+			local f = if (b.t - a.t) > 0 then (t - a.t) / (b.t - a.t) else 1
+			if typeof(a.valor) == "table" then
+				local r = {}
+				for j = 1, #a.valor do
+					r[j] = a.valor[j] + (b.valor[j] - a.valor[j]) * f
+				end
+				return r
+			end
+			return a.valor + (b.valor - a.valor) * f
+		end
+	end
+	return kfs[#kfs].valor
+end
+
+function AgentPanel:_tocarAnimacao(alvo: Instance, trilhas: { any }, duracao: number)
+	self:PararAnimacao()
+	local base = nil :: CFrame?
+	local sizeBase = nil :: Vector3?
+	local parteRaiz = nil :: BasePart?
+	if alvo:IsA("Model") then
+		if not alvo.PrimaryPart and alvo:FindFirstChildWhichIsA("BasePart") then
+			alvo.PrimaryPart = alvo:FindFirstChildWhichIsA("BasePart")
+		end
+		parteRaiz = alvo.PrimaryPart
+		base = (alvo :: Model):GetPivot()
+	else
+		parteRaiz = alvo :: BasePart
+		base = parteRaiz.CFrame
+		sizeBase = parteRaiz.Size
+	end
+	if not parteRaiz or not base then
+		return false, "Selecione um modelo/parte com geometria para animar."
+	end
+	local origem = base :: CFrame
+	local tamanho0 = sizeBase
+	self.animPlaying = true
+	self.animCancel = task.spawn(function()
+		local inicio = os.clock()
+		while self.animPlaying do
+			local t = (os.clock() - inicio) % math.max(0.1, duracao)
+			local offset = Vector3.zero
+			local yaw = 0.0
+			local escala = 1.0
+			for _, trilha in trilhas do
+				local v = interpolar(trilha, t)
+				if v ~= nil then
+					if trilha.propriedade == "Rotation" and typeof(v) == "table" then
+						yaw = math.rad(v[2] or 0)
+					elseif trilha.propriedade == "PositionOffsetY" then
+						offset += Vector3.new(0, v :: number, 0)
+					elseif trilha.propriedade == "PositionOffsetX" then
+						offset += Vector3.new(v :: number, 0, 0)
+					elseif trilha.propriedade == "PositionOffset" and typeof(v) == "table" then
+						offset += Vector3.new(v[1] or 0, v[2] or 0, v[3] or 0)
+					elseif trilha.propriedade == "SizeScale" then
+						escala = v :: number
+					end
+				end
+			end
+			if not parteRaiz.Parent then
+				break
+			end
+			local novo = origem * CFrame.Angles(0, yaw, 0) + offset
+			if alvo:IsA("Model") then
+				(alvo :: Model):PivotTo(novo)
+			else
+				parteRaiz.CFrame = novo
+				if tamanho0 and escala ~= 1 then
+					parteRaiz.Size = tamanho0 * escala
+				end
+			end
+			RunService.Heartbeat:Wait()
+		end
+	end)
+	return true
+end
+
+function AgentPanel:PararAnimacao()
+	self.animPlaying = false
+end
