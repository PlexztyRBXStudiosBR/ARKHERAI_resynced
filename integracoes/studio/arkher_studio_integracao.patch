+		end
+		addResultado("Pesquisando...", "", "", "")
+		task.spawn(function()
+			local corpo: { [string]: any } = { consulta = consulta }
+			if fonteAtual ~= "" then corpo.fonte = fonteAtual end
+			local ok, dados = self:_post("/real/search", corpo)
+			for _, f in resultados:GetChildren() do
+				if f:IsA("Frame") then f:Destroy() end
+			end
+			if not ok then
+				addResultado("Erro", "", tostring((dados or {}).erro), "")
+				return
+			end
+			if dados.ok == false then
+				addResultado("Sem resultado honesto", "", tostring(dados.message or dados.error or "nada encontrado."), "")
+				return
+			end
+			-- modo combinado vem com .fontes; fonte unica vem direto
+			local blocos = if dados.fontes then dados.fontes else { dados }
+			local total = 0
+			for _, bloco in blocos do
+				for _, item in bloco.resultados or {} do
+					total += 1
+					addResultado(item.titulo or "?", item.url or "", item.resumo or "", item.licenca or "")
+				end
+			end
+			for _, falha in dados.falhas or {} do
+				addResultado("[falha honesta] " .. tostring(falha.fonte), "", tostring(falha.erro), "")
+			end
+			if total == 0 then
+				addResultado("Nada encontrado para essa consulta.", "", "", "")
+			end
+			task.wait()
+			resultados.CanvasSize = UDim2.new(0, 0, 0, layoutR.AbsoluteContentSize.Y + 8)
+		end)
+	end)
+end
