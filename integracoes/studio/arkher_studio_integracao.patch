+-- --------------------------------------------------------------------- HTTP
+function AgentPanel:_request(metodo: string, caminho: string, corpo: any?): (boolean, any)
+	local url = API_BASE .. caminho
+	local ok, res = pcall(function()
+		return HttpService:RequestAsync({
+			Url = url,
+			Method = metodo,
+			Headers = { ["Content-Type"] = "application/json" },
+			Body = corpo ~= nil and HttpService:JSONEncode(corpo) or nil,
+		})
+	end)
+	if not ok then
+		return false, { erro = "Backend do Arkher Studio fora do ar (localhost:3000). Abra o backend e tente de novo." }
+	end
+	local resposta = res :: any
+	if not resposta.Success then
+		return false, { erro = string.format("HTTP %d em %s", resposta.StatusCode or 0, caminho) }
+	end
+	local okJson, dados = pcall(function()
+		return HttpService:JSONDecode(resposta.Body)
+	end)
+	if not okJson then
+		return false, { erro = "Resposta inválida do backend." }
+	end
+	return true, dados
+end
+
+function AgentPanel:_post(caminho: string, corpo: any?)
+	return self:_request("POST", caminho, corpo or {})
+end
