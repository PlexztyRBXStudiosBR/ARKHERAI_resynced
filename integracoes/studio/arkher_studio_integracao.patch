+
+	self:TrocarAba("chat")
+	for id, botao in self.tabs do
+		botao.MouseButton1Click:Connect(function()
+			self:TrocarAba(id)
+		end)
+	end
+
+	self:_checarStatus()
+	print("[Arkher Agent] Painel pronto - integrado ao backend ARKHER via", API_BASE)
+end
+
+function AgentPanel:TrocarAba(id: Aba)
+	for nome, pagina in self.pages do
+		pagina.Visible = nome == id
+	end
+	for nome, botao in self.tabs do
+		local ativo = nome == id
+		botao.BackgroundColor3 = if ativo then NEON_DARK else PANEL_CARD
+		botao.TextColor3 = if ativo then NEON else TEXT_DIM
+	end
+end
+
+function AgentPanel:Toggle(forcar: boolean?)
+	if not self.root then return end
+	local alvo = if forcar ~= nil then forcar else not self.open
+	self.open = alvo
+	self.root.Visible = alvo
+	if alvo then
+		self:_checarStatus()
+	end
+end
+
+function AgentPanel:IsOpen(): boolean
+	return self.open
+end
+
+return AgentPanel
