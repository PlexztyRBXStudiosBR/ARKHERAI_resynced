# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
frontend/dist/
.vite/

# Dados de runtime (banco, uploads, logs) — nunca versionar
data/
*.db
*.db-journal
*.sqlite3

# Treinamento: artefatos grandes ficam fora do git.
# Exceção declarada: checkpoints demo pequenos e versionados em model/checkpoints/
model/weights/*
!model/weights/.gitkeep
model/datasets/generated/*
model/training/runs/*

# Ambiente — nunca versionar segredos
.env
*.env.local

# SO / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# dados externos baixados (grandes, recriáveis)
model/datasets/externos/
