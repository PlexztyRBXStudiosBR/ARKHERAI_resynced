[Unit]
Description=ARKHER authenticated agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arkher
Group=arkher
WorkingDirectory=/opt/arkher
EnvironmentFile=/etc/arkher/agent.env
ExecStart=/usr/bin/python3 /opt/arkher/agent.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
# Override these values in a systemd drop-in for the machine/engine size.
MemoryMax=8G
TasksMax=256
LimitNOFILE=4096
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arkher
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
