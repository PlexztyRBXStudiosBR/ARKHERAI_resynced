# Copie para /etc/arkher/agent.env, chmod 600, e preencha localmente.
# Nunca commite o arquivo preenchido nem coloque token em workflow/log.
ARKHER_STATE=/var/lib/arkher
ARKHER_PORT=8765
ARKHER_REQUIRE_TOKEN=1
ARKHER_AGENT_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_20_CHARACTERS
# Origens de navegador separadas por vírgula; vazio bloqueia browser cross-origin.
ARKHER_CORS_ORIGINS=https://seu-site.example
# O agente só expõe arquivos deste workspace por padrão.
ARKHER_ALLOWED_ROOTS=/var/lib/arkher/work
ARKHER_MAX_STATE_BYTES=21474836480
ARKHER_MAX_REQUEST_BYTES=8388608
ARKHER_MAX_OUTPUT_BYTES=2097152
ARKHER_MAX_WRITE_BYTES=10485760
ARKHER_MAX_FILE_BYTES=262144000
ARKHER_MAX_ACTIVE_REQUESTS=64
