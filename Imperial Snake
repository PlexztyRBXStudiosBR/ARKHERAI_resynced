local function ApplyMorph(morphData)
    if not Character or not Humanoid then return end

    local desc = Instance.new("HumanoidDescription")
    desc.Shirt = morphData.Shirt or 0
    desc.Pants = morphData.Pants or 0
    desc.Face = morphData.Face or 0
    desc.HatAccessory = morphData.Hats or ""
    desc.HairAccessory = morphData.Hair or ""
    desc.BackAccessory = morphData.Back or ""
    desc.FaceAccessory = morphData.FaceAccessory or ""
    desc.HeadColor = morphData.HeadColor or Color3.fromRGB(255, 220, 180)
    desc.TorsoColor = morphData.TorsoColor or Color3.fromRGB(255, 220, 180)
    desc.IdleAnimation = morphData.IdleAnim or 0
    desc.WalkAnimation = morphData.WalkAnim or 0
    desc.RunAnimation = morphData.RunAnim or 0

    Humanoid:ApplyDescription(desc)
    ImperialSerpent.ActiveMorph = morphData.Name
    SaveState()
end

local function PlayAnimation(animId, speed, loop)
    if not Character or not Humanoid then return end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. animId
    local track = Humanoid:LoadAnimation(anim)
    track:AdjustSpeed(speed or 1)
    track.Looped = loop or false
    track:Play()

    table.insert(ImperialSerpent.ActiveAnimations, track)
    return track
end

local function Fling(target, power)
    if not Character or not target.Character then return end

    local HRP = Character:FindFirstChild("HumanoidRootPart")
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not HRP or not targetHRP then return end

    local originalCFrame = HRP.CFrame
    local direction = (targetHRP.Position - HRP.Position).Unit

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = direction * (power or 100) * 100
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = HRP

    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
    bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bav.Parent = HRP

    task.wait(0.15)
    bv:Destroy()
    bav:Destroy()
    HRP.CFrame = originalCFrame
end

local function ToggleFly()
    if not Character or not HRP then return end

    ImperialSerpent.FlyEnabled = not ImperialSerpent.FlyEnabled
    if ImperialSerpent.FlyEnabled then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
        bodyVelocity.Parent = HRP

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.Parent = HRP

        local flyConnection
        flyConnection = RunService.Heartbeat:Connect(function()
            if not ImperialSerpent.FlyEnabled or not HRP or not Humanoid then
                flyConnection:Disconnect()
                return
            end

            local moveDirection = Humanoid.MoveDirection
            local camera = workspace.CurrentCamera
            local lookVector = camera.CFrame.LookVector
            local rightVector = camera.CFrame.RightVector

            local velocity = (lookVector * moveDirection.Z + rightVector * moveDirection.X) * ImperialSerpent.Speed
            velocity = Vector3.new(velocity.X, 0, velocity.Z)

            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                velocity = velocity + Vector3.new(0, ImperialSerpent.Speed, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                velocity = velocity + Vector3.new(0, -ImperialSerpent.Speed, 0)
            end

            bodyVelocity.Velocity = velocity
            bodyGyro.CFrame = CFrame.new(HRP.Position, HRP.Position + lookVector)
        end)
    else
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BodyVelocity") or part:IsA("BodyGyro") then
                part:Destroy()
            end
        end
    end
    SaveState()
end

local function ToggleNoclip()
    if not Character then return end

    ImperialSerpent.NoclipEnabled = not ImperialSerpent.NoclipEnabled
    if ImperialSerpent.NoclipEnabled then
        local noclipConnection
        noclipConnection = RunService.Stepped:Connect(function()
            if not ImperialSerpent.NoclipEnabled or not Character then
                noclipConnection:Disconnect()
                return
            end

            for _, part in pairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
    SaveState()
end

local function ToggleESP()
    ImperialSerpent.ESPEnabled = not ImperialSerpent.ESPEnabled
    if ImperialSerpent.ESPEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Parent = player.Character
            end
        end

        Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function(character)
                if ImperialSerpent.ESPEnabled and player ~= LocalPlayer then
                    local highlight = Instance.new("Highlight")
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = character
                end
            end)
        end)
    else
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, descendant in pairs(player.Character:GetDescendants()) do
                    if descendant:IsA("Highlight") then
                        descendant:Destroy()
                    end
                end
            end
        end
    end
    SaveState()
end

local function ToggleAimbot()
    ImperialSerpent.AimbotEnabled = not ImperialSerpent.AimbotEnabled
    if ImperialSerpent.AimbotEnabled then
        local aimbotConnection
        aimbotConnection = RunService.RenderStepped:Connect(function()
            if not ImperialSerpent.AimbotEnabled then
                aimbotConnection:Disconnect()
                return
            end

            local closestPlayer = nil
            local closestDistance = math.huge
            local camera = workspace.CurrentCamera

            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end

            if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local lookAt = CFrame.new(camera.CFrame.Position, closestPlayer.Character.HumanoidRootPart.Position)
                camera.CFrame = lookAt
            end
        end)
    end
    SaveState()
end

