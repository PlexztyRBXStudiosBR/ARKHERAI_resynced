-- ========== [ SISTEMA DE EXPANSÃO DINÂMICA ] ==========
local function AddNewMorph(name, morphData)
    ImperialSerpent.Assets.Morphs[name] = morphData

    -- Encontrar a categoria apropriada
    local category = "Custom"
    for cat, morphs in pairs(morphCategories) do
        for _, morphName in pairs(morphs) do
            if morphName == name then
                category = cat
                break
            end
        end
    end

    -- Adicionar à UI
    Tabs.Morphs:AddButton({
        Title = morphData.Name,
        Description = "Apply " .. morphData.Name .. " morph",
        Callback = function()
            ApplyMorph(morphData)
        end
    }, category)

    Fluent:Notify({
        Title = "New Morph Added!",
        Content = morphData.Name .. " has been added to the Morphs tab.",
        Duration = 3
    })
end

local function AddNewAnimation(name, animId)
    ImperialSerpent.Assets.Animations[name] = animId

    -- Encontrar a categoria apropriada
    local category = "Custom"
    for cat, skills in pairs(skillCategories) do
        for _, skillName in pairs(skills) do
            if skillName == name then
                category = cat
                break
            end
        end
    end

    -- Adicionar à UI
    Tabs.Combat:AddButton({
        Title = name,
        Description = "Play " .. name .. " animation",
        Callback = function()
            PlayAnimation(animId, 1, false)
        end
    }, category)

    Fluent:Notify({
        Title = "New Animation Added!",
        Content = name .. " has been added to the Combat tab.",
        Duration = 3
    })
end

-- ========== [ KEYBINDS ] ==========
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == ImperialSerpent.Config.Keybinds.ToggleUI then
        Window:Toggle()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Fly then
        ToggleFly()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Noclip then
        ToggleNoclip()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Panic then
        Window:Destroy()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.AutoClick then
        ToggleAutoClicker()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.InfiniteJump then
        ToggleInfiniteJump()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.SuperJump then
        ToggleSuperJump()
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Teleport then
        local mouse = LocalPlayer:GetMouse()
        local target = mouse.Hit.Position + Vector3.new(0, 3, 0)
        HRP.CFrame = CFrame.new(target)
    elseif input.KeyCode == ImperialSerpent.Config.Keybinds.Aimbot then
        ToggleAimbot()
    end
end)

