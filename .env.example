# ARKHER AI — variáveis de ambiente (NENHUM valor real aqui; copie para .env)
# Nenhum segredo de provedor externo existe neste projeto por design.

# Rede
ARKHER_HOST=0.0.0.0
ARKHER_PORT=8710

# Origens permitidas no CORS (separadas por vírgula). Padrão cobre só o dev local.
ARKHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dados e modelo
ARKHER_DATA_DIR=./data
ARKHER_CHECKPOINT=./model/checkpoints/latest.pt
ARKHER_TOKENIZER=./model/tokenizer/vocab/bpe_v1.json

# Limites
ARKHER_MAX_MESSAGE_CHARS=4000
ARKHER_MAX_INPUT_TOKENS=140
ARKHER_MAX_NEW_TOKENS=224
ARKHER_GEN_TIMEOUT_S=120
ARKHER_MODEL_LOAD_TIMEOUT_S=90

# Rate limit (por usuário, janela de 1 minuto)
ARKHER_RATE_CHAT_PER_MIN=30
ARKHER_RATE_API_PER_MIN=240

# Frontend servido pelo backend (1) ou não (0)
ARKHER_SERVE_FRONTEND=1
